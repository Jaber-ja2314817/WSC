{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*",
    "scripts/**/*.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
